# lnd or cln (REST); leave unset to run without a funding source. Also
# powers LUD-25's optional Offline verification (signed via the node's own
# signmessage RPC) - there's no separate setting for that.
FUNDINGSOURCE_BACKEND=cln
FUNDINGSOURCE_URL=https://localhost:3010
FUNDINGSOURCE_RUNE=<rune>
# FUNDINGSOURCE_CERT_PATH=/path/to/ca.pem

# alternative: lnd instead of cln
# FUNDINGSOURCE_BACKEND=lnd
# FUNDINGSOURCE_URL=https://localhost:8080
# FUNDINGSOURCE_MACAROON=<hex admin.macaroon>
# FUNDINGSOURCE_CERT_PATH=/path/to/tls.cert

# bounds on a single minted note, in msat
MIN_SENDABLE_MSAT=10000
MAX_SENDABLE_MSAT=1000000000

# LUD-25's optional mint fee: withheld from every minted note's value (a
# flat BASE_FEE_MSAT plus FEE_PERCENT_PPM parts-per-million of the amount
# paid), meant to cover the routing cost of eventually paying the note back
# out on melt. Advertised in /p/cb's payRequest metadata so a wallet can
# warn the payer up front - set both to 0 to run fee-free (the metadata
# entry is then omitted entirely, per spec).
BASE_FEE_MSAT=1000
FEE_PERCENT_PPM=0

# floor on a note's value net of the mint fee (not on the amount paid,
# which MIN_SENDABLE_MSAT already bounds) - guards against minting
# dust-value notes not worth the routing cost of ever melting them
MIN_MINT_MSAT=10000

# cap on the number of k1s a single /w/cb request (melt/rotate/split/merge)
# may name - well above any real wallet's outstanding note count, just to
# bound the DB lookups a single unauthenticated request can force
MAX_K1S=100

DATABASE_PATH=mint.db

# LUD-21 (optional): advertise a `verify` URL in the mint invoice's
# response, so a wallet with no node of its own can poll settlement status.
# Once settled, the response includes the spec's `preimage` field - for
# lnurlcash the preimage IS the bearer note's spend secret, so a wallet with
# no node of its own needs it to claim the note, and MUST rotate the note
# immediately after (this mint's own node is a permanent prior holder of it
# regardless). This setting only controls whether /p/cb *advertises* the
# verify URL - the endpoint itself always responds when hit directly, with
# or without this set. Off by default.
# VERIFY_ENABLED=true

# the one-pager frontend (GET /)
TITLE=lnurl-mint
DESCRIPTION=A minimal lnurlcash mint - pay the QR code to mint a Lightning bearer note.
# public base URL of this mint - used for the QR code's LNURL and the
# lightning address domain. Required: this mint will not derive it from a
# request's own Host header (untrustworthy - can be spoofed by any caller,
# or by a cache poisoning attack if fronted by a Host-agnostic cache).
BASE_URL=https://mint.example
# this mint's Tor hidden service address, if it has one - shown on the
# frontend as an alternative way to reach it. When a wallet is actually
# connecting through it, it's used as the base for LNURL/callback URLs
# instead of BASE_URL above, so paying/withdrawing still works over Tor.
# ONION_URL=http://<v3-address>.onion
# the mint is payable at {USERNAME}@{BASE_URL host}
USERNAME=mint
