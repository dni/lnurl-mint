# lnd or cln (REST); leave unset to run without a funding source
FUNDINGSOURCE_BACKEND=lnd
FUNDINGSOURCE_URL=https://localhost:8080
FUNDINGSOURCE_MACAROON=<hex admin.macaroon>
# FUNDINGSOURCE_RUNE=<rune, cln only>
# FUNDINGSOURCE_CERT_PATH=/path/to/tls.cert

# bounds on a single minted note, in msat
MIN_SENDABLE_MSAT=1000
MAX_SENDABLE_MSAT=1000000000

DATABASE_PATH=mint.db

# the one-pager frontend (GET /)
TITLE=lnurl-mint
DESCRIPTION=A minimal lnurlcash mint - pay the QR code to mint a Lightning bearer note.
# public base URL of this mint - used for the QR code's LNURL and the
# lightning address domain; falls back to each request's own URL when unset
BASE_URL=https://mint.example
# the mint is payable at {USERNAME}@{BASE_URL host}
USERNAME=mint
